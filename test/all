#!/bin/bash

set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OMARCHY_SOURCE=${OMARCHY_PATH:-/usr/share/omarchy}

[[ -d $OMARCHY_SOURCE/shell ]] || {
  echo "Omarchy shell source not found: $OMARCHY_SOURCE" >&2
  exit 1
}

for test_file in "$PLUGIN_DIR"/test/*.test.js; do
  node "$test_file"
done

# hypr/layouts.lua runs inside Hyprland's Lua, so it is exercised with a real
# interpreter against a stand-in `hl` table.
LUA=${LUA:-$(command -v lua5.4 || command -v lua || true)}
if [[ -n $LUA ]]; then
  LUA_STATE=$(mktemp -d)
  XDG_STATE_HOME="$LUA_STATE" "$LUA" "$PLUGIN_DIR/test/layouts.test.lua" "$PLUGIN_DIR"
  rm -rf "$LUA_STATE"
else
  echo "lua not found; skipping hypr/layouts.lua tests" >&2
fi

OMARCHY_PATH="$OMARCHY_SOURCE" omarchy plugin validate "$PLUGIN_DIR"

# qmllint ships with qt6-declarative but Arch does not put it on PATH.
QMLLINT=${QMLLINT:-$(command -v qmllint || true)}
if [[ -z $QMLLINT ]]; then
  for candidate in /usr/lib/qt6/bin/qmllint /usr/lib/qt5/bin/qmllint; do
    [[ -x $candidate ]] && QMLLINT=$candidate && break
  done
fi

if [[ -z $QMLLINT ]]; then
  echo "qmllint not found (install qt6-declarative); skipping QML lint" >&2
  echo "ok - window switcher manifest (QML lint skipped)"
  exit 0
fi

# The shell publishes its modules as `qs.Commons` and `qs.Ui`, but they sit in
# `shell/Commons` and `shell/Ui`. Qt resolves `qs.X` to `<import path>/qs/X`,
# so point the linter at a throwaway tree with that shape; passing the shell
# root directly leaves every `qs.*` import unresolved.
SHIM=$(mktemp -d)
trap 'rm -rf "$SHIM"' EXIT
mkdir -p "$SHIM/qs"
for module in "$OMARCHY_SOURCE"/shell/*/; do
  [[ -f ${module}qmldir ]] && ln -s "${module%/}" "$SHIM/qs/$(basename "$module")"
done

# Three categories are Quickshell structural limits rather than defects in this
# plugin, and every one of them is a false positive here:
#   missing-property  - Color/Style expose surfaces as inline anonymous
#                       QtObjects, which qmllint cannot introspect, so real
#                       tokens like Color.menu.scrim read as missing.
#   unresolved-type   - Quickshell returns QList<QuickshellScreenInfo*> and
#                       friends without declarative type registration.
#   uncreatable-type  - PanelWindow is created by the Quickshell runtime.
"$QMLLINT" -I "$SHIM" \
  --missing-property disable \
  --unresolved-type disable \
  --uncreatable-type disable \
  "$PLUGIN_DIR/Switcher.qml" \
  "$PLUGIN_DIR"/components/*.qml

echo "ok - window switcher manifest and QML"
